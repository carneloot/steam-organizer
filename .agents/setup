#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "Using Node $(node --version) and npm $(npm --version)"

echo "Configuring virtual memory for Oxlint JavaScript plugins"
bash .agents/resume

echo "Installing dependencies from package-lock.json"
time npm ci --engine-strict --no-audit --no-fund

echo "Building the CLI"
time npm run build
