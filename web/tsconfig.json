{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"types": ["@cloudflare/workers-types", "node", "vite/client"]
	},
	"include": ["./**/*.ts", "../alchemy.run.ts"],
	"exclude": ["dist"]
}
