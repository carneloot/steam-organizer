{
	"name": "steam-categorizer",
	"version": "0.1.0",
	"private": true,
	"description": "Organize a Steam library locally with an Effect v4 CLI",
	"bin": {
		"steam-categorizer": "dist/cli.js"
	},
	"type": "module",
	"scripts": {
		"prepare": "effect-tsgo patch --no-typescript --oxlint",
		"dev": "tsx src/cli.ts",
		"build": "tsc",
		"check": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
		"web:dev": "vite --config web/vite.config.ts",
		"web:api": "wrangler dev --config web/wrangler.local.jsonc --port 8787",
		"web:db": "wrangler d1 migrations apply organizer --local --config web/wrangler.local.jsonc",
		"web:build": "vite build --config web/vite.config.ts",
		"web:deploy": "alchemy deploy --stage production",
		"test": "vitest run",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --check .",
		"format:fix": "oxfmt ."
	},
	"dependencies": {
		"@effect/platform-browser": "4.0.0",
		"@effect/platform-node": "4.0.0",
		"effect": "4.0.0",
		"foldkit": "0.166.0"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261007.1",
		"@effect/tsgo": "0.50.0",
		"@effect/vitest": "4.0.0",
		"@foldkit/vite-plugin": "0.26.1",
		"@oxlint/plugins": "1.86.0",
		"@types/node": "^22.0.0",
		"alchemy": "2.0.0-beta.81",
		"esbuild": "0.28.1",
		"miniflare": "5.20261006.0-alpha",
		"oxfmt": "^0.71.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"tsx": "^4.20.0",
		"typescript": "^5.9.0",
		"vite": "8.3.3",
		"vitest": "^5.0.0",
		"wrangler": "4.148.0"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.0.0",
		"@effect/sql-d1": "4.0.0",
		"@effect/sql-sqlite-do": "4.0.0"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
