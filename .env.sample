# Required for sync
STEAM_API_KEY=

# Required for classify/review
TYPESAFE_API_KEY=

# Required for web deployment: comma-separated explicit allowlisted emails
# ACCESS_EMAILS=you@example.com,friend@example.com

# Optional shared rate-limit store; defaults to ~/.cache/steam-categorizer/rate-limits
# API_RATE_LIMIT_DIRECTORY=/path/to/shared/rate-limits
